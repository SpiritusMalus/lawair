ENVIRONMENT=local  # remove on production

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db:5432/DB_NAME
SECRET_KEY=replace-with-random-64-char-string
FERNET_KEY=replace-with-fernet-key-run-python-c-from-cryptography.fernet-import-Fernet-print-Fernet.generate_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://redis:6379/0
PROJECT_NAME=lawair

POSTGRES_USER=replace-with-username
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=replace-with-db-name

# SMTP — leave SMTP_HOST empty to log emails instead of sending (local dev)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_TLS=true

# Celery / RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Frontend base URL — used to build links in emails
FRONTEND_URL=http://localhost:3000
